# Format for this configuration file is
# AddressSpaceID   Command   ByteOffset   Data

##   Address Space ID Settings:
#   PCI_CONFIG_SPACE (PCI Configuration Space)
#   DEV_EIP164_0
#   DEV_EIP164_1
#   DEV_EIP201_0
#   DEV_EIP201_1
#   BOARD_CTRL (FPGA board control)

##   Valid commands are:
#   write
#   read

# EIP-164 registers

# EIP-164 Engine HW version, should read 0x???5ba4
DEV_EIP164_0 read 0xfffc

# EIP-6x Packet Engine HW version, should read 0x???bd42
DEV_EIP164_0 read 0x5ffc

# EIP-201 AIC HW version, should read 0x???36c9
DEV_EIP201_0 read 0x3c
